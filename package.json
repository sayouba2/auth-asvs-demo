    "test:security": "node scripts/test-runner.mjs security",
    "test:static": "node --test scripts/static.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
