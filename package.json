{
  "name": "auth-asvs-demo",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "eslint apps scripts",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test-runner.mjs api",
